HOST=127.0.0.1
PORT=8000
# 默认数据库为项目 data/crm.sqlite3；可配置绝对路径
# DATABASE_URL=sqlite:////absolute/path/crm.sqlite3
ADMIN_USERNAME=admin
# 请自行设置至少12位临时密码，初始化后移除此项
ADMIN_PASSWORD=
SESSION_HOURS=8
# HTTPS 部署时设 true；本地 HTTP 使用 false
COOKIE_SECURE=false
AI_MODE=mock
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
# 仅 macOS scripts/serve_lan.py 使用：自动跟随此网卡的私网 IPv4
LAN_INTERFACE=en0
